# Salin ke .env.local lalu isi. JANGAN commit .env.local.
# Hanya URL dan anon key. Service Role Key dilarang ada di sini.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Base path GitHub Pages (nama repository). Kosongkan "/" saat dev lokal.
VITE_BASE=/whistle/
